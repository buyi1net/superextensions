{
  "name": "superextensions",
  "description": "Agent全局规则总纲，任何会话、任何任务开始前都必须加载并全程遵守。",
  "version": "0.0.1",
  "author": {
    "name": "buyi1net"
  },
  "homepage": "https://github.com/buyi1net/superextensions",
  "repository": "https://github.com/buyi1net/superextensions",
  "license": "MIT",
  "keywords": [
    "rules",
    "constitution",
    "workflow",
    "agent",
    "zh-cn"
  ],
  "skills": [
    "./skills/constitution",
    "./skills/engineering/code-review",
    "./skills/engineering/codebase-design",
    "./skills/engineering/diagnosing-bugs",
    "./skills/engineering/domain-modeling",
    "./skills/engineering/grill-with-docs",
    "./skills/engineering/implement",
    "./skills/engineering/implement-spec",
    "./skills/engineering/improve-codebase-architecture",
    "./skills/engineering/improve-codebase-audit",
    "./skills/engineering/prototype",
    "./skills/engineering/retro",
    "./skills/engineering/tdd",
    "./skills/engineering/to-spec",
    "./skills/engineering/to-tickets",
    "./skills/engineering/wizard",
    "./skills/expression/express-agents",
    "./skills/expression/express-check",
    "./skills/expression/express-translate",
    "./skills/expression/express-writing",
    "./skills/office/docx",
    "./skills/office/pdf",
    "./skills/office/pptx",
    "./skills/office/xlsx",
    "./skills/productivity/clssession",
    "./skills/productivity/grilling",
    "./skills/productivity/handoff",
    "./skills/productivity/management",
    "./skills/productivity/teach",
    "./skills/productivity/wait-what"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/inject-constitution",
              "SessionStart"
            ]
          }
        ]
      }
    ]
  }
}
