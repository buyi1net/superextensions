{
  "name": "superextensions",
  "description": "Agent全局规则总纲，任何会话、任何任务开始前都必须加载并全程遵守。",
  "version": "0.0.1",
  "author": { "name": "buyi1net" },
  "homepage": "https://github.com/buyi1net/superextensions",
  "repository": "https://github.com/buyi1net/superextensions",
  "license": "MIT",
  "keywords": ["rules", "constitution", "workflow", "agent", "zh-cn"],
  "skills": "skills",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/inject-constitution",
              "SessionStart"
            ]
          }
        ]
      }
    ]
  }
}
